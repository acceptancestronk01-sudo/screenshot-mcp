{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["package.json", "payment-verification.js", ".env"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "framework": null,
  "env": {
    "NODE_ENV": "production"
  },
  "buildCommand": "echo 'No build step needed'",
  "outputDirectory": "."
}
